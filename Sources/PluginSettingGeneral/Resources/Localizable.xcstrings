    "Stable builds are recommended. Beta builds contain new features but may be unstable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable builds are recommended. Beta builds contain new features but may be unstable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议使用稳定版。测试版包含新功能，但可能不稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議使用穩定版。測試版包含新功能，但可能不穩定。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
