    "%@ uses about %@ of disk space to keep its plugins, preferences, and credentials.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uses about %2$@ of disk space to keep its plugins, preferences, and credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用约 %2$@ 的磁盘空间来保存插件、偏好设置和凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用約 %2$@ 的磁碟空間來儲存外掛、偏好設定和憑證。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用約 %2$@ 的磁碟空間來儲存外掛、偏好設定和憑證。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用約 %2$@ 的磁碟空間來儲存外掛、偏好設定和憑證。"
          }
        }
      }
    },
